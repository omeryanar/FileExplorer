<UserControl x:Class="FileExplorer.View.ShortcutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
			 xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
			 xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
			 xmlns:helpers="clr-namespace:FileExplorer.Helpers"
			 MinWidth="500" MinHeight="200">

	<UserControl.Resources>
		<helpers:InvalidPathIconSelector x:Key="InvalidPathIconSelector" />
		<dxmvvm:ObjectToObjectConverter x:Key="BooleanToDialogTypeConverter">
			<dxmvvm:MapItem Source="True" Target="Folder" />
			<dxmvvm:MapItem Source="False" Target="FileOpen" />
		</dxmvvm:ObjectToObjectConverter>
	</UserControl.Resources>

	<dxlc:LayoutControl Padding="10">
		<dxlc:LayoutGroup View="Tabs">
			<dxlc:LayoutGroup Header="{Binding Title}">
				<Label Width="75" FontSize="64" VerticalAlignment="Center" Content="{Binding Icon, Converter={StaticResource MessageIconConverter}}" Style="{StaticResource IconLabel}" />
				<dxlc:LayoutGroup ItemSpace="10" Orientation="Vertical">
					<dxe:TextEdit HorizontalAlignment="Stretch" TextWrapping="Wrap" ShowBorder="False" IsReadOnly="{Binding ContentReadOnly}" Text="{Binding Content}" />
					<dxlc:LayoutItem Margin="10,0" AddColonToLabel="True" Label="{Binding Location, Source={StaticResource ResourceProvider}}">
						<dxe:BrowsePathEdit Margin="5,0" IsTextEditable="False" VerticalAlignment="Bottom" PathIconSelector="{StaticResource InvalidPathIconSelector}"											
											DialogType="{Binding IsFolder, Converter={StaticResource BooleanToDialogTypeConverter}}" DialogFilter="{Binding Filter}"
											EditValue="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
					</dxlc:LayoutItem>
				</dxlc:LayoutGroup>
			</dxlc:LayoutGroup>			
		</dxlc:LayoutGroup>
	</dxlc:LayoutControl>

</UserControl>
