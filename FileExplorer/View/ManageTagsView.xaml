<UserControl x:Class="FileExplorer.View.ManageTagsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
			 xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
			 xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
			 xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
			 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
			 xmlns:editors="clr-namespace:FileExplorer.Editors"
			 xmlns:helpers="clr-namespace:FileExplorer.Helpers"
             xmlns:common="clr-namespace:FileExplorer.Core"
             Padding="10,0" MinWidth="800" MinHeight="400">

	<UserControl.Resources>
		<Style TargetType="dxg:GridCardHeaderControl">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate />
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="CardViewBorderStyle" TargetType="Border">
			<Setter Property="Background" Value="{DynamicResource {dxgt:LWKey GridRow.BorderNoneBrush}}" />
			<Setter Property="TextBlock.Foreground" Value="{DynamicResource {dxgt:LWKey GridRow.TextUnfocusedBrush}}" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsSelected}" Value="True">
					<Setter Property="Background" Value="{DynamicResource {dxgt:LWKey GridRow.BorderFocusedBrush}}" />
					<Setter Property="TextBlock.Foreground" Value="{DynamicResource {dxgt:LWKey GridRow.TextFocusedBrush}}"/>
				</DataTrigger>
				<DataTrigger Binding="{Binding IsFocused}" Value="True">
					<Setter Property="Background" Value="{DynamicResource {dxgt:LWKey GridRow.BorderFocusedBrush}}" />
					<Setter Property="TextBlock.Foreground" Value="{DynamicResource {dxgt:LWKey GridRow.TextFocusedBrush}}"  />
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<ControlTemplate x:Key="{dxgt:LWKey GridCard.ContainerTemplate}" TargetType="{x:Type ContentControl}">
			<ContentPresenter />
		</ControlTemplate>
	</UserControl.Resources>

	<dxg:GridControl ItemsSource="{Binding}">
		<dxg:GridControl.View>
			<dxg:TableView AutoWidth="True" AllowColumnFiltering="False" AllowColumnMoving="False" AllowSorting="False"
                           IsColumnMenuEnabled="False" ShowGroupPanel="False" VerticalScrollbarVisibility="Auto" NavigationStyle="Row"
                           EditFormShowMode="Inline" EditFormPostConfirmation="YesNoCancel" EditFormPostMode="Immediate" NewItemRowPosition="Bottom" ValidateRow="{DXEvent 'Update(@args.Row)'}">
				<dxg:TableView.EditFormTemplate>
					<DataTemplate>
						<dxlc:LayoutControl Orientation="Vertical">
							<dxlc:LayoutGroup Orientation="Horizontal" ItemSpace="20">
								<dxlc:LayoutItem Width="150" Label="{Binding Icon, Source={StaticResource ResourceProvider}}">
									<dxg:EditFormEditor FieldName="IconData" />
								</dxlc:LayoutItem>
								<dxlc:LayoutGroup Orientation="Vertical" ItemSpace="10">
									<dxlc:LayoutItem Label="{Binding Name, Source={StaticResource ResourceProvider}}">
										<dxg:EditFormEditor FieldName="Name" />
									</dxlc:LayoutItem>
									<dxlc:LayoutItem Label="{Binding Color, Source={StaticResource ResourceProvider}}">
										<dxg:EditFormEditor FieldName="IconColor" />
									</dxlc:LayoutItem>
								</dxlc:LayoutGroup>
							</dxlc:LayoutGroup>
							<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
								<Button Margin="0,10,10,0" Width="75" Height="25" Command="{Binding CommitCommand}"
										Content="{Binding OK, Source={StaticResource ResourceProvider}}" />
								<Button Margin="0,10,0,0" Width="75" Height="25" Command="{Binding CancelCommand}"
										Content="{Binding Cancel, Source={StaticResource ResourceProvider}}" />
							</StackPanel>
						</dxlc:LayoutControl>
					</DataTemplate>
				</dxg:TableView.EditFormTemplate>
			</dxg:TableView>
		</dxg:GridControl.View>
		<dxg:GridControl.Columns>
			<dxg:GridColumn FieldName="Name" Header="{Binding Name, Source={StaticResource ResourceProvider}}">
				<dxg:GridColumn.CellDisplayTemplate>
					<DataTemplate>
						<StackPanel Orientation="Horizontal">
							<Viewbox Width="16" Height="16" Margin="8">
								<Path Data="{Binding Row.IconData}" Fill="{Binding Row.IconColor}" />
							</Viewbox>
							<TextBlock VerticalAlignment="Center" Text="{Binding Row.Name}" />
						</StackPanel>
					</DataTemplate>
				</dxg:GridColumn.CellDisplayTemplate>
			</dxg:GridColumn>
			<dxg:GridColumn FieldName="IconColor" Visible="False" Header="{Binding Color, Source={StaticResource ResourceProvider}}">
				<dxg:GridColumn.EditFormTemplate>
					<DataTemplate>
						<editors:MaterialColorEdit EditValue="{Binding Value, Converter={common:StringToColorConverter}}" />
					</DataTemplate>
				</dxg:GridColumn.EditFormTemplate>
			</dxg:GridColumn>
			<dxg:GridColumn FieldName="IconData" Visible="False" Header="{Binding Icon, Source={StaticResource ResourceProvider}}">
				<dxg:GridColumn.EditFormTemplate>
					<DataTemplate>
						<dxg:LookUpEdit x:Name="PART_Editor" IsTextEditable="False" DisplayMember="Color" ValueMember="Data" PopupMinWidth="600"
										ItemsSource="{Binding Source={x:Static helpers:FontIconHelper.AwesomeIcons}}">
							<dxg:LookUpEdit.StyleSettings>
								<dxg:SearchLookUpEditStyleSettings />
							</dxg:LookUpEdit.StyleSettings>
							<dxg:LookUpEdit.EditNonEditableTemplate>
								<ControlTemplate>
									<Viewbox Margin="4" Width="48" Height="48">
										<Path Fill="{Binding (dxe:BaseEdit.OwnerEdit).DataContext.RowData.Source.Row.IconColor, RelativeSource={RelativeSource TemplatedParent}}" 
											  Data="{Binding (dxe:BaseEdit.OwnerEdit).EditValue}" />
									</Viewbox>
								</ControlTemplate>
							</dxg:LookUpEdit.EditNonEditableTemplate>
							<dxg:LookUpEdit.PopupContentTemplate>
								<ControlTemplate>
									<dxg:GridControl x:Name="PART_GridControl">
										<dxg:GridControl.Columns>
											<dxg:GridColumn FieldName="Name" />
											<dxg:GridColumn FieldName="Data" />
											<dxg:GridColumn FieldName="Description" Visible="False" />
										</dxg:GridControl.Columns>
										<dxg:GridControl.View>
											<dxg:CardView AllowEditing="False" CardLayout="Rows" ShowGroupPanel="False" ShowColumnHeaders="False" SeparatorThickness="0" CardMargin="0"
														  ShowSearchPanelMode="Always" SearchPanelPosition="OverGroupPanel" SearchColumns="Name;Description" SearchDelay="500">
												<dxg:CardView.HeaderTemplate>
													<DataTemplate />
												</dxg:CardView.HeaderTemplate>
												<dxg:CardView.CardTemplate>
													<DataTemplate>
														<Border Padding="4" Style="{StaticResource CardViewBorderStyle}" ToolTip="{Binding Row.Name}">
															<StackPanel Width="64" Height="64">
																<Viewbox Margin="4" Width="32" Height="32">
																	<Path  Fill="{Binding (dxe:BaseEdit.OwnerEdit).DataContext.RowData.Source.Row.IconColor, RelativeSource={RelativeSource TemplatedParent}}" Data="{Binding Row.Data}" />
																</Viewbox>
																<TextBlock TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Text="{Binding Row.Name}" />
															</StackPanel>
														</Border>
													</DataTemplate>
												</dxg:CardView.CardTemplate>
											</dxg:CardView>
										</dxg:GridControl.View>
									</dxg:GridControl>
								</ControlTemplate>
							</dxg:LookUpEdit.PopupContentTemplate>
						</dxg:LookUpEdit>
					</DataTemplate>
				</dxg:GridColumn.EditFormTemplate>
			</dxg:GridColumn>
			<dxg:GridColumn Header="{Binding ItemCount, Source={StaticResource ResourceProvider}}" Binding="{Binding TaggedFiles.Count}" />
			<dxg:GridColumn FixedWidth="True" Width="50">
				<dxg:GridColumn.CellTemplate>
					<DataTemplate>
						<StackPanel Orientation="Horizontal" Visibility="{Binding RowData.IsNewItemRow, Converter={dxmvvm:BooleanToVisibilityConverter Inverse=True}}">
							<Button Style="{StaticResource FlatButtonStyle}" Content="{StaticResource IconEdit}" Command="{x:Static dxg:GridCommands.EditFocusedRow}"
									ToolTip="{Binding Edit, Source={StaticResource ResourceProvider}}" />
							<Button Style="{StaticResource FlatButtonStyle}" Content="{StaticResource IconDelete}" ToolTip="{Binding Delete, Source={StaticResource ResourceProvider}}">
								<dxmvvm:Interaction.Behaviors>
									<dxmvvm:ConfirmationBehavior MessageIcon="Question" Command="{Binding View.Commands.DeleteFocusedRow}"
																 MessageTitle="{Binding ConfirmDelete, Source={StaticResource ResourceProvider}}"
																 MessageText="{Binding ConfirmDeleteMessage, Source={StaticResource ResourceProvider}}" />
								</dxmvvm:Interaction.Behaviors>
							</Button>
						</StackPanel>
					</DataTemplate>
				</dxg:GridColumn.CellTemplate>
			</dxg:GridColumn>
		</dxg:GridControl.Columns>
	</dxg:GridControl>
	
</UserControl>
